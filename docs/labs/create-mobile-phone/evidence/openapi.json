          },
          "title": {
            "type": "string",
            "description": "Short safe error title.",
            "example": "Validation failed."
          },
          "status": {
            "type": "integer",
            "description": "HTTP status, equal to the actual response status.",
            "format": "int32",
            "example": 400
          },
          "detail": {
            "type": "string",
            "description": "Safe error explanation; server exceptions do not expose their internal message.",
            "example": "The request failed validation."
          },
          "instance": {
            "type": "string",
            "description": "Actual request path, without query parameters.",
            "format": "uri-reference",
            "example": "/mobile-phones"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code; see the problem contract for status/cause mappings.",
            "example": "validation_failed"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "description": "Validation errors; an empty array for failures without domain validation errors."
          },
          "missingProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Serializer-required members missing from the failing object; empty for other causes.",
            "example": [
              "commonDescription"
            ]
          },
          "traceId": {
            "type": "string",
            "description": "Request trace identifier for correlating diagnostics; not a fixed value.",
            "example": "example-trace-id"
          }
        },
        "additionalProperties": {},
        "description": "Response object. All listed fields are present; nullability is specified separately from presence."
      },
      "CommonDescriptionDto": {
        "required": [
          "brand",
          "description",
          "mainPhoto",
          "name",
          "otherPhotos"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the phone; create/update reject blank names.",
            "example": "Galaxy S24"
          },
          "brand": {
            "type": "string",
            "description": "Free-text phone brand; create/update reject blank brands. The filter uses a separate enum.",
            "example": "Samsung"
          },
          "description": {
            "type": "string",
            "description": "Main product description; create/update reject blank text.",
            "example": "An Android phone with an OLED display."
          },
          "mainPhoto": {
            "type": "string",
            "description": "Main photo reference as stored. May be a relative filename or URL; not constrained to an absolute URI.",
            "example": "main-photo.jpg"
          },
          "otherPhotos": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Additional stored photo references, in supplied order; an empty array is allowed.",
            "example": [
              "side-photo.jpg"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Response object. All listed fields are present; nullability is specified separately from presence."
      },
